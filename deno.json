{
  "lock": true,
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.ns", "dom", "dom.iterable", "esnext"]
  },
  "fmt": {
    "lineWidth": 100,
    "indentWidth": 2,
    "semiColons": true,
    "singleQuote": false
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "tasks": {
    "fmt:check": "deno fmt --check deno.json package.json .github/workflows/ci.yml supabase/functions tests/unit",
    "lint": "deno lint supabase/functions tests/unit",
    "check": "deno check supabase/functions/health/index.ts supabase/functions/health/handler.ts supabase/functions/_shared/infrastructure/clock.ts supabase/functions/_shared/infrastructure/telegram-port.ts supabase/functions/_shared/infrastructure/redact.ts supabase/functions/_shared/contracts/content.ts supabase/functions/_shared/contracts/domain.ts",
    "test:unit": "deno test tests/unit",
    "verify": "deno task fmt:check && deno task lint && deno task check && deno task test:unit"
  }
}
